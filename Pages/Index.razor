@page "/"
@using InsuranceSystem;

<h1>Insurance Coverage Estimate</h1>

<div class="mb-3">
    <label for="patientName" class="form-label">Patient:</label>
    <select name="patientName" id="patientName" class="form-select" @bind="selectedPatientID">
    <option value="">Select a patient</option>
    @foreach (var patient in patientRepo.getAllPatients())
    {
        <option value="@patient.getPolicyNumber()">@patient.getPatientName()</option>
    }
    </select>
</div>

<div class="mb-3">
    <label for="medicalProcedure" class="form-label">Medical procedure:</label>
    <select name="medicalProcedure" id="medicalProcedure" class="form-select" @bind="selectedProcedure">
    <option value="0">Broken Arm</option>
    <option value="1">Broken Wrist</option>
    <option value="2">Broken Finger</option>
    <option value="3">Broken Leg</option>
    <option value="4">Broken Toe</option>
    </select>
</div>

<div class="mb-3">
    <label for="amountCharged" class="form-label">Procedure cost:</label>
    <input type="number" id="amountCharged" name="amountCharged" class="form-control"
       min="0" step="0.01" @bind="strAmountCharged">
</div>

<button class="btn btn-primary" @onclick="CalculateCoverage">Estimate coverage</button>

@if (!string.IsNullOrEmpty(validationMessage))
{
    <p class="text-danger mt-3" role="alert">@validationMessage</p>
}

@if (!string.IsNullOrEmpty(strAmountCovered))
{
    <p class="mt-3" aria-live="polite">
    Estimated amount covered: <strong>@strAmountCovered</strong>
    </p>
    <p>
    Insurance type: @selectedInsuranceType
    </p>
}


@code {
    private readonly PatientRepository patientRepo = new();
    private string strAmountCharged = string.Empty;
    private string strAmountCovered = string.Empty;
    private string selectedPatientID = string.Empty;
    private string selectedProcedure = "0";
    private string selectedInsuranceType = string.Empty;
    private string validationMessage = string.Empty;

    private void CalculateCoverage()
    {
        strAmountCovered = string.Empty;
        selectedInsuranceType = string.Empty;
        validationMessage = string.Empty;

        if (string.IsNullOrWhiteSpace(selectedPatientID))
        {
            validationMessage = "Please select a patient.";
            return;
        }

        if (!decimal.TryParse(strAmountCharged, out decimal amountCharged))
        {
            validationMessage = "Enter a valid procedure cost.";
            return;
        }

        if (amountCharged < 0)
        {
            validationMessage = "Procedure cost cannot be negative.";
            return;
        }

        if (!int.TryParse(selectedProcedure, out int selectProcedureNumber))
        {
            validationMessage = "Please select a medical procedure.";
            return;
        }

        InsuranceInterface selectPatient = patientRepo.getPatientByPolicy(selectedPatientID);
        decimal amountCovered = selectPatient.CoverageAmount(selectProcedureNumber, amountCharged);
        strAmountCovered = amountCovered.ToString("C2");
        selectedInsuranceType = selectPatient.GetType().Name switch
        {
            "InNetworkPatient" => "In-network",
            "OutNetworkAdapter" => "Out-of-network (through the adapter)",
            _ => "Not identified"
        };
    }
}
